### Tabelas Detalhadas

#### 1. **users** - Usuários do Sistema

```sql
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE NOT NULL,
    phone_country_code VARCHAR(5),
    phone_national_number VARCHAR(20),
    phone_raw_input VARCHAR(25),
    phone_region_code VARCHAR(5),
    
    -- Dados Pessoais
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    display_name VARCHAR(100),
    gender VARCHAR(10) CHECK (gender IN ('MALE', 'FEMALE', 'OTHER')),
    birthdate DATE,
    bio TEXT,
    bio_moderation_status VARCHAR(20) DEFAULT 'PENDING',
    
    -- Foto de Perfil
    picture_url TEXT,
    has_picture BOOLEAN DEFAULT FALSE,
    picture_moderation_status VARCHAR(20) DEFAULT 'PENDING',
    
    -- Verificações
    id_checked VARCHAR(20) DEFAULT 'TO_CHECK',
    phone_verified BOOLEAN DEFAULT FALSE,
    email_verified BOOLEAN DEFAULT FALSE,
    phone_hidden BOOLEAN DEFAULT FALSE,
    
    -- Avaliações
    rating DECIMAL(3,2) DEFAULT 0,
    rating_count INTEGER DEFAULT 0,
    driving_rating INT,
    grade INTEGER DEFAULT 0,
    
    -- Estatísticas
    rides_offered INTEGER DEFAULT 0,
    rides_taken INTEGER DEFAULT 0,
    response_rate INTEGER DEFAULT 0,
    
    -- Preferências de Viagem
    smoking_preference VARCHAR(10) DEFAULT 'MAYBE',
    music_preference VARCHAR(10) DEFAULT 'MAYBE',
    pets_preference VARCHAR(10) DEFAULT 'MAYBE',
    dialog_preference VARCHAR(10) DEFAULT 'MAYBE',
    
    -- Configurações
    signed_charter BOOLEAN DEFAULT FALSE,
    booking_type VARCHAR(20) DEFAULT 'online',
    recurring_booking_eligible BOOLEAN DEFAULT FALSE,
    
    -- Social
    social_connections JSONB DEFAULT '{}',
    
    -- Timestamps
    last_login TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Índices
CREATE INDEX idx_users_email ON users(email);
CREATE INDEX idx_users_phone ON users(phone_national_number);
CREATE INDEX idx_users_rating ON users(rating DESC);
```

#### 2. **vehicles** - Veículos dos Motoristas

```sql
CREATE TABLE vehicles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    
    -- Identificação
    make VARCHAR(50) NOT NULL,  -- Ex: VOLKSWAGEN, TOYOTA
    model VARCHAR(100) NOT NULL, -- Ex: POLO, COROLLA
    year INTEGER,
    license_plate VARCHAR(20),
    
    -- Aparência
    color VARCHAR(50),
    color_hex VARCHAR(7),
    
    -- Classificação
    category VARCHAR(20) CHECK (category IN (
        'SEDAN',      -- Berline/Sedan
        'TOURISM',    -- Veículo de turismo
        'CONVERTIBLE',-- Cabriolet
        'WAGON',      -- Break/Station Wagon
        'SUV',        -- 4x4
        'VAN',        -- Monospace/Van
        'SMALL_UTILITY',
        'BIG_UTILITY'
    )),
    
    comfort_level VARCHAR(20) CHECK (comfort_level IN (
        'BASIC',
        'NORMAL',
        'COMFORT',
        'LUXURY'
    )),
    comfort_stars INTEGER CHECK (comfort_stars BETWEEN 1 AND 5),
    
    -- Capacidade
    number_of_seats INTEGER DEFAULT 4,
    
    -- Mídia
    pictures JSONB DEFAULT '[]',
    
    -- Status
    is_active BOOLEAN DEFAULT TRUE,
    is_verified BOOLEAN DEFAULT FALSE,
    
    -- Timestamps
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_vehicles_user ON vehicles(user_id);
```

#### 3. **trips** - Viagens Oferecidas

```sql
CREATE TABLE trips (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    driver_id UUID REFERENCES users(id) ON DELETE CASCADE,
    vehicle_id UUID REFERENCES vehicles(id),
    
    -- Identificação
    permanent_id VARCHAR(100) UNIQUE, -- Ex: "12345-luanda-benguela"
    
    -- Frequência
    frequency VARCHAR(20) DEFAULT 'UNIQUE' CHECK (frequency IN (
        'UNIQUE',
        'DAILY',
        'WEEKLY',
        'WEEKDAYS'
    )),
    
    -- Horários
    departure_datetime TIMESTAMP WITH TIME ZONE NOT NULL,
    
    -- Local de Partida
    departure_city VARCHAR(100) NOT NULL,
    departure_address TEXT,
    departure_latitude DECIMAL(10, 8),
    departure_longitude DECIMAL(11, 8),
    departure_country_code VARCHAR(2) DEFAULT 'AO',
    
    -- Local de Chegada
    arrival_city VARCHAR(100) NOT NULL,
    arrival_address TEXT,
    arrival_latitude DECIMAL(10, 8),
    arrival_longitude DECIMAL(11, 8),
    arrival_country_code VARCHAR(2) DEFAULT 'AO',
    
    -- Preço
    price DECIMAL(10, 2) NOT NULL,
    currency VARCHAR(3) DEFAULT 'AOA',
    price_with_commission DECIMAL(10, 2),
    
    -- Lugares
    seats_total INTEGER NOT NULL DEFAULT 4,
    seats_left INTEGER NOT NULL DEFAULT 4,
    
    -- Duração/Distância
    duration_seconds INTEGER,
    distance_km INTEGER,
    
    -- Detalhes
    comment TEXT,
    is_freeway BOOLEAN DEFAULT TRUE,
    
    luggage_size VARCHAR(20) DEFAULT 'MEDIUM' CHECK (luggage_size IN (
        'SMALL', 'MEDIUM', 'LARGE'
    )),
    
    detour_allowed VARCHAR(20) DEFAULT 'NONE' CHECK (detour_allowed IN (
        'NONE', 'SMALL', 'MEDIUM', 'LARGE'
    )),
    
    schedule_flexibility VARCHAR(30) DEFAULT 'FIFTEEN_MINUTES',
    
    -- Reservas
    booking_mode VARCHAR(20) DEFAULT 'manual' CHECK (booking_mode IN (
        'manual',  -- Motorista aprova
        'auto'     -- Aprovação automática
    )),
    booking_type VARCHAR(20) DEFAULT 'online',
    
    -- Status
    status VARCHAR(20) DEFAULT 'ACTIVE' CHECK (status IN (
        'ACTIVE',
        'COMPLETED',
        'CANCELLED',
        'EXPIRED'
    )),
    
    -- Métricas
    view_count INTEGER DEFAULT 0,
    question_response_count INTEGER DEFAULT 0,
    answer_delay INTEGER DEFAULT 12, -- Horas
    
    -- Flags
    is_comfort BOOLEAN DEFAULT FALSE,
    cross_border_alert BOOLEAN DEFAULT FALSE,
    
    -- Timestamps
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Índices para busca
CREATE INDEX idx_trips_departure_city ON trips(departure_city);
CREATE INDEX idx_trips_arrival_city ON trips(arrival_city);
CREATE INDEX idx_trips_departure_datetime ON trips(departure_datetime);
CREATE INDEX idx_trips_status ON trips(status);
CREATE INDEX idx_trips_driver ON trips(driver_id);
CREATE INDEX idx_trips_search ON trips(departure_city, arrival_city, departure_datetime, status)
    WHERE status = 'ACTIVE';
```

#### 4. **waypoints** - Paradas Intermediárias

```sql
CREATE TABLE waypoints (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    trip_id UUID REFERENCES trips(id) ON DELETE CASCADE,
    
    order_index INTEGER NOT NULL,
    
    type VARCHAR(20)[] NOT NULL, -- ['TRIP_DEPARTURE', 'PICKUP'] ou ['TRIP_ARRIVAL', 'DROPOFF']
    
    city VARCHAR(100) NOT NULL,
    address TEXT,
    latitude DECIMAL(10, 8),
    longitude DECIMAL(11, 8),
    country_code VARCHAR(2) DEFAULT 'AO',
    
    arrival_datetime TIMESTAMP WITH TIME ZONE,
    departure_datetime TIMESTAMP WITH TIME ZONE,
    
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_waypoints_trip ON waypoints(trip_id);
```

#### 5. **bookings** - Reservas

```sql
CREATE TABLE bookings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    trip_id UUID REFERENCES trips(id) ON DELETE CASCADE,
    passenger_id UUID REFERENCES users(id) ON DELETE CASCADE,
    
    -- Identificação
    booking_code VARCHAR(10) UNIQUE NOT NULL,
    file_number VARCHAR(20),
    
    -- Detalhes
    seats_booked INTEGER DEFAULT 1,
    
    -- Preços
    unit_price DECIMAL(10, 2) NOT NULL,
    total_price DECIMAL(10, 2) NOT NULL,
    commission DECIMAL(10, 2) DEFAULT 0,
    half_commission DECIMAL(10, 2),
    price_paid DECIMAL(10, 2),
    price_paid_without_commission DECIMAL(10, 2),
    currency VARCHAR(3) DEFAULT 'AOA',
    
    -- Reembolsos
    passenger_refund DECIMAL(10, 2) DEFAULT 0,
    driver_compensation DECIMAL(10, 2) DEFAULT 0,
    
    -- Status
    status VARCHAR(30) NOT NULL DEFAULT 'PENDING' CHECK (status IN (
        'PENDING',
        'WAIT_PAYMENT_INFO',
        'BOOKED',
        'CONFIRMED',
        'CANCELLED_BY_PASSENGER',
        'CANCELLED_BY_DRIVER',
        'COMPLETED',
        'REFUNDED'
    )),
    
    -- Datas
    expire_date TIMESTAMP WITH TIME ZONE,
    trip_is_passed BOOLEAN DEFAULT FALSE,
    
    -- Contato
    message_contact_allowed BOOLEAN DEFAULT TRUE,
    phone_contact_allowed BOOLEAN DEFAULT FALSE,
    
    -- Timestamps
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_bookings_trip ON bookings(trip_id);
CREATE INDEX idx_bookings_passenger ON bookings(passenger_id);
CREATE INDEX idx_bookings_status ON bookings(status);
CREATE INDEX idx_bookings_code ON bookings(booking_code);
```

#### 6. **payments** - Pagamentos

```sql
CREATE TABLE payments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    booking_id UUID REFERENCES bookings(id) ON DELETE CASCADE,
    
    -- Referências
    merchant_reference VARCHAR(100),
    payment_reference BIGINT,
    
    -- Provedor
    provider VARCHAR(50) NOT NULL, -- 'multicaixa', 'unitel_money', 'paypal'
    provider_label VARCHAR(100),
    method_id INTEGER,
    one_click_enabled BOOLEAN DEFAULT FALSE,
    
    -- Valores
    amount DECIMAL(10, 2) NOT NULL,
    currency VARCHAR(3) DEFAULT 'AOA',
    
    -- Status
    status VARCHAR(30) DEFAULT 'PENDING' CHECK (status IN (
        'PENDING',
        'PROCESSING',
        'COMPLETED',
        'FAILED',
        'REFUNDED',
        'CANCELLED'
    )),
    
    -- Resposta do Provedor
    provider_response JSONB,
    
    -- Timestamps
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    completed_at TIMESTAMP WITH TIME ZONE
);

CREATE INDEX idx_payments_booking ON payments(booking_id);
CREATE INDEX idx_payments_status ON payments(status);
```

#### 7. **ratings** - Avaliações

```sql
CREATE TABLE ratings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    sender_id UUID REFERENCES users(id) ON DELETE CASCADE,
    receiver_id UUID REFERENCES users(id) ON DELETE CASCADE,
    trip_id UUID REFERENCES trips(id),
    booking_id UUID REFERENCES bookings(id),
    
    -- Tipo de Avaliação
    role VARCHAR(20) NOT NULL CHECK (role IN ('driver', 'passenger')),
    
    -- Nota
    global_rating INTEGER NOT NULL CHECK (global_rating BETWEEN 1 AND 5),
    
    -- Comentário
    comment TEXT,
    
    -- Moderação
    moderation_status VARCHAR(20) DEFAULT 'ACTIVE',
    
    -- Timestamps
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_ratings_receiver ON ratings(receiver_id);
CREATE INDEX idx_ratings_sender ON ratings(sender_id);
CREATE INDEX idx_ratings_trip ON ratings(trip_id);

-- Trigger para atualizar média de rating do usuário
CREATE OR REPLACE FUNCTION update_user_rating()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE users
    SET rating = (
        SELECT COALESCE(AVG(global_rating), 0)
        FROM ratings
        WHERE receiver_id = NEW.receiver_id
    ),
    rating_count = (
        SELECT COUNT(*)
        FROM ratings
        WHERE receiver_id = NEW.receiver_id
    )
    WHERE id = NEW.receiver_id;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_update_user_rating
AFTER INSERT OR UPDATE ON ratings
FOR EACH ROW EXECUTE FUNCTION update_user_rating();
```

#### 8. **messages** - Mensagens entre Usuários

```sql
CREATE TABLE messages (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    trip_id UUID REFERENCES trips(id),
    booking_id UUID REFERENCES bookings(id),
    
    sender_id UUID REFERENCES users(id) ON DELETE CASCADE,
    receiver_id UUID REFERENCES users(id) ON DELETE CASCADE,
    
    content TEXT NOT NULL,
    
    is_read BOOLEAN DEFAULT FALSE,
    read_at TIMESTAMP WITH TIME ZONE,
    
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_messages_trip ON messages(trip_id);
CREATE INDEX idx_messages_booking ON messages(booking_id);
CREATE INDEX idx_messages_receiver ON messages(receiver_id, is_read);
```

