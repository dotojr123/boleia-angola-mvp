-- Grant permissions to the database user
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO boleia_user;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO boleia_user;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO boleia_user;